    "html": "<style>.iws-hero{position:relative;overflow:hidden;background:radial-gradient(ellipse at 75% 0,#0b3a5c 0,#050b18 62%);color:#e6f1ff;padding:5rem 0}.iws-hero::before{content:\"\";position:absolute;inset:0;background-image:linear-gradient(rgba(0,200,255,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(0,200,255,.09) 1px,transparent 1px);background-size:48px 48px;animation:iwsg 16s linear infinite;-webkit-mask-image:linear-gradient(#000,transparent);mask-image:linear-gradient(#000,transparent)}@keyframes iwsg{to{background-position:0 48px}}@keyframes iwsd{to{stroke-dashoffset:-200}}@keyframes iwsb{50%{opacity:.15}}.iws-hero svg{position:absolute;inset:0;width:100%;height:100%;opacity:.6}.iws-hero .cp{fill:none;stroke:#19d3ff;stroke-width:1.5;stroke-dasharray:6 14;animation:iwsd 6s linear infinite}.iws-hero .led{fill:#19ffb4;animation:iwsb 1.8s ease-in-out infinite}.iws-hero .led:nth-child(2n){animation-delay:.6s;fill:#19d3ff}.iws-hero .led:nth-child(3n){animation-delay:1.1s}.iws-hero .gc-wrap{position:relative;z-index:1}.iws-hero .gc-h1,.iws-hero .gc-lead{color:#e6f1ff}.iws-hero .gc-eyebrow{color:#19d3ff}.iws-hero em{color:#19d3ff;font-style:normal}@media(prefers-reduced-motion:reduce){.iws-hero::before,.iws-hero .cp,.iws-hero .led{animation:none}}</style><div class=\"gc\"><section class=\"gc-sec iws-hero\"><svg viewBox=\"0 0 1200 500\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\"><path class=\"cp\" d=\"M0 120H300L340 160H620\"/><path class=\"cp\" d=\"M1200 80H900L860 120H700V300\"/><path class=\"cp\" d=\"M0 380H200L240 340H480V460H800\"/><path class=\"cp\" d=\"M1200 400H1000L960 440H760\"/><rect x=\"900\" y=\"190\" width=\"150\" height=\"150\" rx=\"10\" fill=\"rgba(5,20,40,.7)\" stroke=\"#19d3ff\"/><rect x=\"935\" y=\"225\" width=\"80\" height=\"80\" rx=\"6\" fill=\"none\" stroke=\"#19ffb4\"/><g stroke=\"#19d3ff\" stroke-width=\"2\"><path d=\"M930 190v-20M960 190v-20M990 190v-20M1020 190v-20M930 340v20M960 340v20M990 340v20M1020 340v20M900 230h-20M900 260h-20M900 290h-20M1050 230h20M1050 260h20M1050 290h20\"/></g><g><circle class=\"led\" cx=\"975\" cy=\"265\" r=\"6\"/><circle class=\"led\" cx=\"60\" cy=\"440\" r=\"4\"/><circle class=\"led\" cx=\"90\" cy=\"440\" r=\"4\"/><circle class=\"led\" cx=\"120\" cy=\"440\" r=\"4\"/><circle class=\"led\" cx=\"340\" cy=\"160\" r=\"4\"/><circle class=\"led\" cx=\"700\" cy=\"300\" r=\"4\"/><circle class=\"led\" cx=\"480\" cy=\"460\" r=\"4\"/></g></svg><div class=\"gc-wrap\"><p class=\"gc-eyebrow\">Managed hosting for e-commerce</p><h1 class=\"gc-h1\">Your online store, <em>run by people who know it.</em></h1><p class=\"gc-lead\">Managed hosting for WooCommerce and PrestaShop with migration, backups, updates and support. Traffic included, no billing surprises.</p><div class=\"gc-act\"><a class=\"gc-btn gc-btn-a\" href=\"__BASEURL__/en/shop/\">See the plans</a> <a class=\"gc-btn gc-btn-o\" href=\"__BASEURL__/en/services/\">How it works</a></div></div></section></div>"
  },
  {
    "id": "categorie",
    "nome": "Products",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec gc-soft\" id=\"categorie\"><div class=\"gc-wrap\"><p class=\"gc-eyebrow\">Products</p><h2 class=\"gc-h2\">Choose what you need</h2><p class=\"gc-lead\">From virtual servers to managed hosting and AI models.</p><div class=\"gc-plat\"><div class=\"gc-pl\"><b>VPS and cloud</b><p>Ready-to-use virtual servers, traffic included.</p><p><a class=\"gc-link\" href=\"__BASEURL__/en/shop/category/vps/\">See the plans</a></p></div><div class=\"gc-pl\"><b>Managed hosting</b><p>Managed WooCommerce and PrestaShop: updates, backups and support.</p><p><a class=\"gc-link\" href=\"__BASEURL__/en/shop/category/web/\">See the plans</a></p></div><div class=\"gc-pl\"><b>AI and LLM</b><p>Open source models pay-as-you-go and dedicated GPUs.</p><p><a class=\"gc-link\" href=\"__BASEURL__/en/shop/category/ai/\">See the plans</a></p></div><div class=\"gc-pl\"><b>Game servers</b><p>Game servers with dedicated resources.</p><p><a class=\"gc-link\" href=\"__BASEURL__/en/shop/category/game/\">See the plans</a></p></div></div></div></section></div>"
  },
  {
    "id": "metodo",
    "nome": "How it works",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec\" id=\"metodo\"><div class=\"gc-wrap\"><p class=\"gc-eyebrow\">How it works</p><h2 class=\"gc-h2\">From choice to live site</h2><div class=\"gc-plat\"><div class=\"gc-pl\"><span class=\"n\">01</span><b>Choose</b><p>Pick the plan that fits your store.</p></div><div class=\"gc-pl\"><span class=\"n\">02</span><b>Migrate</b><p>We move your site without downtime.</p></div><div class=\"gc-pl\"><span class=\"n\">03</span><b>Manage</b><p>Backups, updates and security included.</p></div><div class=\"gc-pl\"><span class=\"n\">04</span><b>Grow</b><p>Move to more resources when needed.</p></div></div></div></section></div>"
  },
  {
    "id": "contatti",
    "nome": "Contact",
    "enabled": true,
    "html": "<div class=\"gc\"><section class=\"gc-sec gc-dark\" id=\"contatti\"><div class=\"gc-wrap\"><h2 class=\"gc-h2\">Already have a store?</h2><p class=\"gc-lead\">Tell us where it is hosted and we will propose how to migrate it.</p><a class=\"gc-btn\" href=\"__BASEURL__/en/contact/\">Contact us</a></div></section></div>"
